@{
    ViewData["Title"] = "Admission Brochure";
    Layout = "~/Views/Shared/_Layout.cshtml";   // change if needed
}

<style>

    .brochure-section {
        /* max-width: 1100px; */
        margin: 60px auto;
        padding: 20px;
        background: #fffef5;
        border-radius: 8px;
    }

    .brochure-block {
        margin-bottom: 35px;
    }

    .brochure-heading {
        background: #1527B3;
        padding: 8px 15px;
        font-weight: bold;
        color: #FFFF;
        display: inline-block;
    }

    .brochure-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 10px;
    }

        .brochure-table td {
            border: 1px solid #999;
            padding: 8px;
        }

    .uniform-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 25px;
    }

    .features-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 30px;
    }

    .small-note {
        font-size: 14px;
        margin-top: 10px;
    }

    .signature-section {
        display: flex;
        justify-content: space-between;
        margin-top: 50px;
        font-weight: bold;
    }

    /* RESPONSIVE */

    @@media (max-width: 768px) {

        .features-grid {
            grid-template-columns: 1fr;
        }

        .signature-section {
            flex-direction: column;
            gap: 20px;
            text-align: center;
        }
    }

    @@media (max-width: 576px) {

        .brochure-heading {
            font-size: 14px;
        }

        .brochure-section {
            padding: 15px;
        }
    }

</style>

<div class="page-header bg-section dark-section parallaxie">
    <div class="container">
        <div class="row">+
            <div class="col-lg-12">
                <!-- Page Header Box Start -->
                <div class="page-header-box">
                    <h1 class="text-anime-style-3" data-cursor="-opaque">Admision Brochure</h1>
                    <nav class="wow fadeInUp">
                        <ol class="breadcrumb">
                            <!-- <li class="breadcrumb-item"><a href="index-2.html">Home</a></li>
                            <li class="breadcrumb-item active" aria-current="page">Contact us</li> -->
                        </ol>
                    </nav>
                </div>
                <!-- Page Header Box End -->
            </div>
        </div>
    </div>
</div>


    

