    <script src="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/owl.carousel.min.js"></script>
    <script>
        $(document).ready(function () {
            if ($('.owl-carousel').length) {
                $('.owl-carousel').owlCarousel({
                    loop: true,
                    margin: 10,
                    nav: true,
                    dots: true,
                    autoplay: true,
                    autoplayTimeout: 2000,
                    smartSpeed: 800,
                    responsive: {
                        0: { items: 1 },
                        576: { items: 2 },
                        768: { items: 3 },
                        992: { items: 4 }
                    }
                });
            } else {
                console.log("❌ Owl carousel container not found");
            }
        });
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // Get current route from Razor
            var currentController = '@ViewContext.RouteData.Values["controller"]';
            var currentAction = '@ViewContext.RouteData.Values["action"]';

            // Run only on Home/Index
            if (currentController === "Home" && currentAction === "Index") {

                const popup = document.getElementById("admissionPopup");
                const closeBtn = document.getElementById("closePopup");

                if (popup) {

                    // Show popup only on Home page
                    popup.style.display = "flex";
                    document.body.style.overflow = "hidden";

                    function closePopup() {
                        popup.style.display = "none";
                        document.body.style.overflow = "auto";
                    }

                    if (closeBtn) {
                        closeBtn.addEventListener("click", closePopup);
                    }

                    popup.addEventListener("click", function (e) {
                        if (e.target === popup) {
                            closePopup();
                        }
                    });
                }
            }

        });
    </script>

